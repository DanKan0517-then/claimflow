# Copy to .env and change the secrets before deploying.

# Public hostname (used by nginx and CORS)
SERVER_NAME=localhost
PUBLIC_URL=http://localhost

# Postgres
POSTGRES_DB=claimflow
POSTGRES_USER=claimflow
POSTGRES_PASSWORD=change-me-postgres

# Redis
REDIS_PASSWORD=change-me-redis

# Must be at least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: real LLM analysis via Groq (free tier). Without it, the rule-based analyser is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Load demo users and claims on first start
SEED_DEMO=true

# Workflow rules
MANAGER_APPROVAL_THRESHOLD=50000
HIGH_RISK_FRAUD_SCORE=70

# Grafana admin
GRAFANA_PASSWORD=change-me-grafana

# Production only: email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=
