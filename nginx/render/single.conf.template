# Render demo: nginx and the Spring Boot API run in ONE container, so a single wake-up
# brings both back. nginx listens on Render's $PORT and proxies to the API on localhost:8080.

upstream claimflow_api {
    server 127.0.0.1:8080;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m   rate=10r/m;
limit_req_zone $binary_remote_addr zone=upload_limit:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=api_limit:10m    rate=${API_RATE_LIMIT}r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

log_format claimflow_json escape=json
    '{"time":"$time_iso8601","request_id":"$request_id","remote":"$remote_addr",'
    '"method":"$request_method","uri":"$request_uri","status":$status,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';

server {
    listen ${PORT} default_server;
    access_log /dev/stdout claimflow_json;

    # Render's edge proxy is in front: use the real client IP for rate limiting.
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Render health check: only healthy once the API itself is ready.
    location = /healthz {
        access_log off;
        proxy_pass http://claimflow_api/actuator/health/readiness;
    }

    include /etc/nginx/snippets/claimflow-locations.conf;
}
